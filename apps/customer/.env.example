# ==============================================================================
# Customer Portal Next.js App Environment Variables Template
# ==============================================================================
# Copy this file to .env in this directory (or use a root-level symlink/file)
# ==============================================================================

NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. Database & Cache Infrastructure (Required for SSR/Prisma in Next.js Server)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://cms:cms_password@localhost:5432/ecom?schema=public"
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. NextAuth.js (Auth.js) v5 Configuration
# ------------------------------------------------------------------------------
# Primary secret used to encrypt session tokens/cookies
AUTH_SECRET="your-auth-secret-here-change-in-production"
NEXTAUTH_URL="your-next-auth-url-here-change-in-production"

# Trust headers from reverse proxies (required when hosted behind Nginx/Cloudflare etc.)
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. Customer Session Control Policies
# ------------------------------------------------------------------------------
CUSTOMER_SESSION_CACHE_TTL_SEC=30
CUSTOMER_SESSION_MAX_AGE_DAYS=30
CUSTOMER_SESSION_ABSOLUTE_TIMEOUT_DAYS=90
CUSTOMER_SESSION_IDLE_TIMEOUT_DAYS=7
CUSTOMER_MAX_SESSIONS_PER_USER=10

# ------------------------------------------------------------------------------
# 4. JSON Web Token (JWT) Configurations
# ------------------------------------------------------------------------------
# Secret for validating JWTs for mobile/extension and client endpoints
JWT_SECRET="your-jwt-secret-here-change-in-production"

# ------------------------------------------------------------------------------
# 5. Client / Public Parameters (Exposed to Browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_CUSTOMER_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 6. OAuth 2.0 Configurations
# ------------------------------------------------------------------------------
#Google OAuth
AUTH_GOOGLE_ID="your-auth-google-id-here-change-in-production"
AUTH_GOOGLE_SECRET="your-auth-google-secret-here-change-in-production"

#Facebook OAuth
FACEBOOK_CLIENT_ID="your-client-id-here-change-in-production"
FACEBOOK_CLIENT_SECRET="your-client-secret-here-change-in-production"
