# ==============================================================================
# Customer Portal Next.js App Environment Variables Template
# ==============================================================================
# Copy this file to .env in this directory (or use a root-level symlink/file)
# ==============================================================================

NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. NextAuth.js (Auth.js) v5 Configuration
# ------------------------------------------------------------------------------
# Primary secret used to encrypt session tokens/cookies
AUTH_SECRET="your-auth-secret-here-change-in-production"

# ------------------------------------------------------------------------------
# 2. Customer Session Control Policies
# ------------------------------------------------------------------------------
CUSTOMER_SESSION_CACHE_TTL_SEC=30
CUSTOMER_SESSION_MAX_AGE_DAYS=30
CUSTOMER_SESSION_ABSOLUTE_TIMEOUT_DAYS=90
CUSTOMER_SESSION_IDLE_TIMEOUT_DAYS=7
CUSTOMER_MAX_SESSIONS_PER_USER=10

# ------------------------------------------------------------------------------
# 3. JSON Web Token (JWT) Configurations
# ------------------------------------------------------------------------------
# Secret for validating JWTs for mobile/extension and client endpoints
JWT_SECRET="your-jwt-secret-here-change-in-production"

# ------------------------------------------------------------------------------
# 4. Client / Public Parameters (Exposed to Browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_CUSTOMER_URL="http://localhost:3001"
