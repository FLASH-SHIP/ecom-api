    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.0",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
