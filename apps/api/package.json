{
  "name": "@ecom/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "yarn generate:openapi",
    "build": "nest build",
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx dist/src/main.js",
    "start:prod": "node --import tsx dist/src/main.js",
    "type-check": "tsc --noEmit",
    "db:seed": "tsx src/seed.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "generate:openapi": "tsx src/export-openapi.ts all",
    "generate:openapi:customer": "tsx src/export-openapi.ts customer",
    "generate:openapi:admin": "tsx src/export-openapi.ts admin",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.9",
    "@bull-board/express": "^6.7.9",
    "@ecom/features": "workspace:*",
    "@ecom/prisma": "workspace:*",
    "@flash-ship/ecom-config": "portal:../../../ecom-shared-packages/packages/config",
    "@flash-ship/ecom-i18n": "portal:../../../ecom-shared-packages/packages/i18n",
    "@flash-ship/ecom-lib": "portal:../../../ecom-shared-packages/packages/lib",
    "@flash-ship/ecom-trpc": "portal:../../../ecom-shared-packages/packages/trpc",
    "@flash-ship/ecom-types": "portal:../../../ecom-shared-packages/packages/types",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.0",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "helmet": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@flash-ship/ecom-tsconfig": "portal:../../../ecom-shared-packages/packages/tsconfig",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.41",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "tsx": "^4.22.4",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
