# ==============================================================================
# NestJS API App Environment Variables Template
# ==============================================================================
# Copy this file to .env in this directory (or use a root-level symlink/file)
# ==============================================================================

NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. Database & Cache Infrastructure
# ------------------------------------------------------------------------------
# PostgreSQL primary connection URL
DATABASE_URL="postgresql://cms:cms_password@localhost:5432/ecom?schema=public"

# Database replica configuration (optional)
# DATABASE_REPLICA_URL="postgresql://cms:cms_password@localhost:5432/ecom_replica?schema=public"
# DATABASE_REPLICA_URLS="postgresql://replica1...,postgresql://replica2..."

# Connection pool size limit (default: 10)
DATABASE_POOL_MAX=10

# Redis connection string for queuing, caching, and rate limiting
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------
API_PORT=4000
API_PREFIX="/api/v2"
API_TIMEOUT_MS=10000

# Client App URLs for CORS policies and redirect verification
WEB_URL="http://localhost:3000"
CUSTOMER_APP_URL="http://localhost:3001"
ADMIN_URL="http://localhost:4001"

# ------------------------------------------------------------------------------
# 3. Authentication & JWT
# ------------------------------------------------------------------------------
# JWT secrets (minimum 8 characters)
JWT_SECRET="your-jwt-secret-here-change-in-production"
JWT_ADMIN_SECRET="your-jwt-admin-secret-here-change-in-production"

# Optional JWT Refresh Secret. If not set, JWT_SECRET is typically used as fallback
# JWT_REFRESH_SECRET="your-jwt-refresh-secret-here-change-in-production"

# Expiration periods
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="30d"
JWT_ACTIVE_CACHE_TTL_SECONDS=780

# Swagger Admin Docs Protection (HTTP Basic Auth)
SWAGGER_ADMIN_USER="admin"
SWAGGER_ADMIN_PASSWORD="admin123"

# ------------------------------------------------------------------------------
# 4. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Logging level (debug | info | warn | error)
LOG_LEVEL="debug"

# Enable request auditing middleware (true | false)
LOG_REQUESTS="true"

# Data retention policies
LOG_PURGE_REQUEST_DAYS=30
LOG_PURGE_AUDIT_DAYS=90
LOG_PURGE_CRON="0 2 * * *"

# ------------------------------------------------------------------------------
# 5. Email Service (SMTP)
# ------------------------------------------------------------------------------
# SMTP credentials for transactional emails (e.g. registration, OTP, notifications)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="noreply@ecom.com"

# ------------------------------------------------------------------------------
# 6. Media & Storage Service
# ------------------------------------------------------------------------------
# Storage driver (local | s3)
STORAGE_DISK="local"

# S3 configuration (used when STORAGE_DISK is "s3")
# STORAGE_S3_BUCKET="your-bucket-name"
# STORAGE_S3_REGION="ap-southeast-1"
# STORAGE_S3_ENDPOINT=""
# STORAGE_S3_CDN_URL=""
# STORAGE_S3_ACCESS_KEY=""
# STORAGE_S3_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 7. Seeding & Database Migrations (Optional)
# ------------------------------------------------------------------------------
# Comma-separated list of model seeds to run (e.g., "roles,users,settings")
# SEED_ONLY=""
# Allow seeding on production environments (0 | 1)
# ALLOW_PROD_SEED=0

# ------------------------------------------------------------------------------
# 8. System Maintenance & Diagnostics
# ------------------------------------------------------------------------------
# Security key to perform diagnostic and maintenance tasks
SYSTEM_MAINTENANCE_KEY="your-server-maintenance-key"
API_KEYS_LIMIT_PER_OWNER=10
LOG_PURGE_AUDIT_KEEP_LATEST="true"

# ------------------------------------------------------------------------------
# 9. Notification & Delivery System Settings
# ------------------------------------------------------------------------------
# Firebase Service Account JSON (stringified JSON config for webpush/mobile notifications)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# Primary and secondary email delivery integrations (resend | ses | smtp)
EMAIL_PROVIDER_PRIMARY="smtp"
EMAIL_PROVIDER_SECONDARY="resend"

# Resend Mail Service configuration
# RESEND_API_KEY="re_..."

# AWS SES Configuration
# AWS_SES_ACCESS_KEY_ID=""
# AWS_SES_SECRET_ACCESS_KEY=""
# AWS_SES_REGION="ap-southeast-1"

# Delivery controls and rate-limits
NOTIFICATION_DEDUPLICATION_TTL_SEC=86400
NOTIFICATION_DEBOUNCE_WINDOW_SEC=120
NOTIFICATION_SMART_ROUTING_FALLBACK_SEC=600

# Data retention policies for notifications (in days)
NOTIFICATION_READ_PURGE_DAYS=14
NOTIFICATION_UNREAD_PURGE_DAYS=45
NOTIFICATION_DEVICE_TOKEN_EXPIRY_DAYS=90

# Do Not Disturb (DND) default hours & settings
NOTIFICATION_DND_DEFAULT_START="22:00"
NOTIFICATION_DND_DEFAULT_END="06:00"
NOTIFICATION_TIMEZONE="Asia/Ho_Chi_Minh"
NOTIFICATION_MAX_TOKENS_PER_OWNER=10

# Webhook security secret for notification status updates
NOTIFICATION_WEBHOOK_SECRET="whsec_devsecret"

