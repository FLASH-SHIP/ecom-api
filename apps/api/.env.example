# ==============================================================================
# NestJS API App Environment Variables Template (@ecom/api)
# ==============================================================================
# Copy this tệp to .env in this directory (or use root-level .env file):
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV="development"
API_PORT=4000
API_PREFIX="/api/v1"
API_TIMEOUT_MS=10000

# Client App URLs for CORS policies and redirect verification
WEB_URL="http://localhost:3000"
CUSTOMER_APP_URL="http://localhost:3001"
ADMIN_URL="http://localhost:4001"
# CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:4001"

# ------------------------------------------------------------------------------
# 2. Database Infrastructure (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL primary connection URL
DATABASE_URL="postgresql://cms:cms_password@localhost:5432/ecom?schema=public"

# Connection pool max limit (default: 10)
DATABASE_POOL_MAX=10

# Optional database replica configuration for read-write splitting
# DATABASE_REPLICA_URL="postgresql://cms:cms_password@localhost:5432/ecom_replica?schema=public"
# DATABASE_REPLICA_URLS="postgresql://replica1...,postgresql://replica2..."

# ------------------------------------------------------------------------------
# 3. Cache & Queue Infrastructure (Redis)
# ------------------------------------------------------------------------------
# Redis connection URL for caching, queues (BullMQ), and rate limiting
REDIS_URL="redis://localhost:6379"

# Redis cluster nodes configuration (optional)
# REDIS_CLUSTER_NODES="redis-node1:6379,redis-node2:6379"

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Primary JWT secrets for signing Customer & Admin tokens (min 8 characters)
JWT_SECRET="dev-jwt-secret-do-not-use-in-production"
JWT_ADMIN_SECRET="dev-jwt-admin-secret-do-not-use-in-production"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-do-not-use-in-production"

# Optional separate refresh secrets for Customer & Admin
# JWT_CUSTOMER_REFRESH_SECRET="dev-jwt-customer-refresh-secret"
# JWT_ADMIN_REFRESH_SECRET="dev-jwt-admin-refresh-secret"
# JWT_SECRET_FALLBACK="previous-jwt-secret-for-zero-downtime-rotation"

# NextAuth / Auth.js session secret compatibility
AUTH_SECRET="dev-secret-do-not-use-in-production"
NEXTAUTH_SECRET="dev-secret-do-not-use-in-production"

# Token expiration and cache TTL settings
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="30d"
JWT_ACTIVE_CACHE_TTL_SECONDS=780

# ------------------------------------------------------------------------------
# 5. Swagger Admin Documentation Protection
# ------------------------------------------------------------------------------
# Basic HTTP Authentication credentials for Swagger admin docs (/api/v1/docs/admin)
SWAGGER_ADMIN_USER="admin"
SWAGGER_ADMIN_PASSWORD="admin123"

# ------------------------------------------------------------------------------
# 6. Logging, Auditing & Housekeeping
# ------------------------------------------------------------------------------
# Log verbosity level (debug | info | warn | error)
LOG_LEVEL="debug"

# Enable HTTP request auditing middleware (true | false)
LOG_REQUESTS="true"

# Data retention policies & automatic purge schedule
LOG_PURGE_REQUEST_DAYS=30
LOG_PURGE_AUDIT_DAYS=90
LOG_PURGE_CRON="0 2 * * *"
LOG_PURGE_AUDIT_KEEP_LATEST="true"

# ------------------------------------------------------------------------------
# 7. Media & File Storage
# ------------------------------------------------------------------------------
# File storage driver (local | s3)
STORAGE_DISK="local"

# Amazon S3 / S3-compatible bucket settings (required if STORAGE_DISK="s3")
# STORAGE_S3_BUCKET="your-bucket-name"
# STORAGE_S3_REGION="ap-southeast-1"
# STORAGE_S3_ENDPOINT=""
# STORAGE_S3_CDN_URL=""
# STORAGE_S3_ACCESS_KEY=""
# STORAGE_S3_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 8. Email & Transactional Delivery Service
# ------------------------------------------------------------------------------
# Primary and secondary email delivery integrations (smtp | resend | ses)
EMAIL_PROVIDER_PRIMARY="smtp"
EMAIL_PROVIDER_SECONDARY="resend"

# SMTP Server credentials (used when provider is "smtp")
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="noreply@ecom.com"

# Resend Mail Service configuration (used when provider is "resend")
# RESEND_API_KEY="re_..."

# AWS SES Configuration (used when provider is "ses")
# AWS_SES_ACCESS_KEY_ID=""
# AWS_SES_SECRET_ACCESS_KEY=""
# AWS_SES_REGION="ap-southeast-1"

# ------------------------------------------------------------------------------
# 9. Notification & Delivery System Settings
# ------------------------------------------------------------------------------
# Firebase Service Account JSON (stringified JSON config for webpush/mobile notifications)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# Delivery controls and rate-limits
NOTIFICATION_DEDUPLICATION_TTL_SEC=86400
NOTIFICATION_DEBOUNCE_WINDOW_SEC=120
NOTIFICATION_SMART_ROUTING_FALLBACK_SEC=600

# Data retention policies for notifications (in days)
NOTIFICATION_READ_PURGE_DAYS=14
NOTIFICATION_UNREAD_PURGE_DAYS=45
NOTIFICATION_DEVICE_TOKEN_EXPIRY_DAYS=90

# Do Not Disturb (DND) default hours & settings
NOTIFICATION_DND_DEFAULT_START="22:00"
NOTIFICATION_DND_DEFAULT_END="06:00"
NOTIFICATION_TIMEZONE="Asia/Ho_Chi_Minh"
NOTIFICATION_MAX_TOKENS_PER_OWNER=10

# Webhook security secret for notification status updates
NOTIFICATION_WEBHOOK_SECRET="whsec_devsecret"

# ------------------------------------------------------------------------------
# 10. System Maintenance, Security & Diagnostics
# ------------------------------------------------------------------------------
# Security key to perform diagnostic and database maintenance tasks
SYSTEM_MAINTENANCE_KEY="your-server-maintenance-key"
API_KEYS_LIMIT_PER_OWNER=10

# Sentry DSN for production error monitoring (optional)
# SENTRY_DSN="https://xxxx@sentry.io/12345"
