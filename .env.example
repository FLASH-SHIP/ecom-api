# ==============================================================================
# Ecom Monorepo Environment Variables Template
# ==============================================================================
# Copy this file to .env at the root of the project for local development:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Cache Infrastructure
# ------------------------------------------------------------------------------
# PostgreSQL connection string and connection pool size
DATABASE_URL="postgresql://cms:cms_password@localhost:5432/ecom?schema=public"
DATABASE_POOL_MAX=10

# Database replica configuration (optional)
# DATABASE_REPLICA_URL="postgresql://cms:cms_password@localhost:5432/ecom_replica?schema=public"
# DATABASE_REPLICA_URLS="postgresql://replica1...,postgresql://replica2..."

# Redis connection string for queuing, caching, and rate limiting
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. API Backend Module (@ecom/api)
# ------------------------------------------------------------------------------
# Local NestJS API port and routing prefix
API_PORT=4000
API_PREFIX="/api/v2"
API_TIMEOUT_MS=10000

# Client App URLs for CORS policies and redirect verification
WEB_URL="http://localhost:3000"
CUSTOMER_APP_URL="http://localhost:3001"
ADMIN_URL="http://localhost:4001"

# JWT configuration for mobile app, browser extension, and script authentication
JWT_SECRET="your-jwt-secret-here-change-in-production"
JWT_ADMIN_SECRET="your-jwt-admin-secret-here-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here-change-in-production"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="30d"

# Logging configuration (debug | info | warn | error)
LOG_LEVEL="debug"
LOG_REQUESTS="true"
LOG_PURGE_REQUEST_DAYS=30
LOG_PURGE_AUDIT_DAYS=90
LOG_PURGE_CRON="0 2 * * *"

# Seeding & migration configuration (optional)
# SEED_ONLY="roles,users"
# ALLOW_PROD_SEED=1

# ------------------------------------------------------------------------------
# 3. Admin CMS App (@ecom/admin)
# ------------------------------------------------------------------------------
# Public API and App URLs for Next.js routing and SSR API requests
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:4001"

# NextAuth v5 (Auth.js) config
# AUTH_SECRET is the primary secret key used to encrypt session tokens
AUTH_SECRET="your-auth-secret-here-change-in-production"
# NEXTAUTH_SECRET (legacy/compat fallback)
NEXTAUTH_SECRET="your-auth-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:4001"
# Trust headers from reverse proxies (required when hosted behind Nginx/Cloudflare etc.)
AUTH_TRUST_HOST="true"

# Admin Session Controls (optional, fallback values shown)
ADMIN_SESSION_MAX_AGE_DAYS=7
ADMIN_SESSION_ABSOLUTE_TIMEOUT_HOURS=72
ADMIN_SESSION_IDLE_TIMEOUT_HOURS=2
ADMIN_SESSION_CACHE_TTL_SEC=15
ADMIN_MAX_SESSIONS_PER_USER=5

# ------------------------------------------------------------------------------
# 4. Customer App (@ecom/customer)
# ------------------------------------------------------------------------------
# Base URL for the Customer-facing Next.js application
CUSTOMER_APP_URL="http://localhost:3001"
NEXT_PUBLIC_CUSTOMER_URL="http://localhost:3001"

# Customer Session Controls (optional, fallback values shown)
CUSTOMER_SESSION_CACHE_TTL_SEC=30
CUSTOMER_SESSION_MAX_AGE_DAYS=30
CUSTOMER_SESSION_ABSOLUTE_TIMEOUT_DAYS=90
CUSTOMER_SESSION_IDLE_TIMEOUT_DAYS=7
CUSTOMER_MAX_SESSIONS_PER_USER=10

# ------------------------------------------------------------------------------
# 5. Web/Marketing App (@ecom/web)
# ------------------------------------------------------------------------------
# Base URL for the Web-facing Next.js application
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. Email Service (SMTP)
# ------------------------------------------------------------------------------
# SMTP credentials for transactional emails (e.g. registration, OTP, notifications)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="noreply@ecom.com"

# ------------------------------------------------------------------------------
# 7. Media & Storage Service
# ------------------------------------------------------------------------------
# Storage driver (local | s3)
STORAGE_DISK="local"

# S3 configuration (used when STORAGE_DISK is "s3")
# STORAGE_S3_BUCKET="your-bucket-name"
# STORAGE_S3_REGION="ap-southeast-1"
# STORAGE_S3_ENDPOINT=""
# STORAGE_S3_CDN_URL=""
# STORAGE_S3_ACCESS_KEY=""
# STORAGE_S3_SECRET_KEY=""
