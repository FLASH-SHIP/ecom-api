{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@flash-ship/ecom-trpc-types/server/*": [
        "./server/*"
      ],
      "@flash-ship/ecom-trpc-types/server": [
        "./server/index.ts"
      ],
      "@flash-ship/ecom-trpc-types/*": [
        "./server/*"
      ],
      "@flash-ship/ecom-trpc-types": [
        "./server/index.ts"
      ],
      "@flash-ship/ecom-trpc/server/*": [
        "./server/*"
      ],
      "@flash-ship/ecom-trpc/server": [
        "./server/index.ts"
      ],
      "@flash-ship/ecom-trpc/*": [
        "./server/*"
      ],
      "@flash-ship/ecom-trpc": [
        "./server/index.ts"
      ],
      "@ecom/trpc/*": [
        "./server/*"
      ],
      "@ecom/trpc": [
        "./server/index.ts"
      ],
      "@ecom/features/*": [
        "../features/*"
      ],
      "@ecom/prisma": [
        "../prisma/src"
      ],
      "@ecom/prisma/*": [
        "../prisma/*"
      ],
      "@flash-ship/ecom-lib/*": [
        "../../node_modules/@flash-ship/ecom-lib/src/*"
      ],
      "@flash-ship/ecom-lib": [
        "../../node_modules/@flash-ship/ecom-lib/src"
      ],
      "@flash-ship/ecom-types": [
        "../../node_modules/@flash-ship/ecom-types/src"
      ],
      "@flash-ship/ecom-i18n": [
        "../../node_modules/@flash-ship/ecom-i18n/src"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "server/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
