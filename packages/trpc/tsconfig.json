{
  "extends": "@ecom/tsconfig/library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "..",
    "noEmit": true,
    "paths": {
      "@ecom/trpc/*": ["./*"],
      "@ecom/features/*": ["../features/*"]
    }
  },
  "include": ["server/**/*.ts", "../features/**/*.ts"],
  "exclude": ["node_modules", "dist", "../features/**/__tests__/**", "../features/**/*.test.ts"]
}
