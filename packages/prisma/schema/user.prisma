// Ecom — User & Authorization (RBAC) Module

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String     @unique
  username      String?    @unique
  name          String?
  phone         String?
  avatarUrl     String?
  emailVerified DateTime?
  locale        String?    @default("vi")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Auth relations
  password     UserPassword?
  sessions     Session[]
  accounts     Account[]
  apiKeys      ApiKey[]
  accessTokens AccessToken[]

  // Authorization
  roles UserRoleAssignment[]

  // Business
  posts     Post[]
  pages     Page[]
  revisions Revision[]

  // Profile
  meta UserMeta[]

  // System
  auditLogs          AuditLog[]
  requestLogs        RequestLog[]
  contactAssignments ContactSubmission[] @relation("ContactAssignee")
  notifications      Notification[]      @relation("UserNotifications")

  @@index([status])
  @@map("users")
}

model UserPassword {
  hash   String
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_passwords")
}

model UserMeta {
  id        Int      @id @default(autoincrement())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String // e.g. "theme"
  value     String // e.g. "dark" | "light"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
  @@map("user_meta")
}

model Session {
  id           String   @id @default(uuid(7)) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  loginAt      DateTime @default(now())
  lastActiveAt DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            String  @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedKey  String    @unique
  label      String?
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([hashedKey])
  @@index([userId])
  @@map("api_keys")
}

model AccessToken {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  refreshTokenHash String    @unique
  clientType       String    @default("mobile") // mobile | extension
  deviceInfo       String?
  expiresAt        DateTime
  refreshExpiresAt DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([refreshTokenHash])
  @@map("access_tokens")
}

model Role {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  displayName String?
  description String?
  permissions RolePermission[]
  users       UserRoleAssignment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique // e.g. "blog.posts.create"
  displayName String?
  group       String? // e.g. "blog"
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId Int

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId Int

  @@id([userId, roleId])
  @@map("user_role_assignments")
}
