// Ecom — Customer Domain Module

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum VerificationCodeStatus {
  PENDING
  VERIFIED
  EXPIRED
}

model Customer {
  id                  String         @id @default(uuid(7)) @db.Uuid
  customerCode        String?        @unique @map("customer_code")
  email               String         @unique
  username            String         @unique
  usernameChangeCount Int            @default(0)
  usernameChangedAt   DateTime?
  name                String?
  phone               String?
  avatarUrl           String?
  hashedPassword      String?
  tokenVersion        Int            @default(1)
  status              CustomerStatus @default(ACTIVE)
  emailVerified       DateTime?
  lastLoginAt         DateTime?
  dob                 DateTime?      @db.Date
  gender              String?
  description         String?        @db.Text
  metadata            Json?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  groupId Int?           @map("group_id")
  group   CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  socialAccounts CustomerSocialAccount[]
  activityLogs   CustomerActivityLog[]
  comments       Comment[]
  sessions       CustomerSession[]
  orders         Order[]
  orderImports   OrderImport[]
  notifications        Notification[]        @relation("CustomerNotifications")
  deviceTokens         DeviceToken[]
  notificationSettings NotificationSetting[]
  senders              CustomerSender[]
  receivers            CustomerReceiver[]
  packages             CustomerPackage[]

  @@index([status])
  @@index([customerCode])
  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@index([groupId])
  @@index([status, deletedAt, createdAt])
  @@map("customers")
}

model CustomerSession {
  id           String   @id @default(uuid(7)) @db.Uuid
  sessionToken String   @unique
  customerId   String   @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expires      DateTime
  loginAt      DateTime @default(now())
  lastActiveAt DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@map("customer_sessions")
}

model CustomerSocialAccount {
  id         Int      @id @default(autoincrement())
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   String
  providerId String   @map("provider_id")
  email      String?
  name       String?
  avatarUrl  String?  @map("avatar_url")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([provider, providerId])
  @@index([customerId])
  @@map("customer_social_accounts")
}

model CustomerActivityLog {
  id         Int      @id @default(autoincrement())
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  action     String
  ipAddress  String?
  userAgent  String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([action])
  @@index([createdAt])
  @@map("customer_activity_logs")
}

model CustomerVerificationCode {
  id        Int                    @id @default(autoincrement())
  email     String
  code      String
  attempts  Int                    @default(0)
  status    VerificationCodeStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([email])
  @@index([status])
  @@map("customer_verification_codes")
}

model CustomerSender {
  id         Int      @id @default(autoincrement())
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label      String?
  name       String
  phone      String?
  email      String?
  address    String   @db.Text
  city       String
  ward       String?
  zipCode    String?  @map("zip_code")
  country    String   @default("VN")
  isDefault  Boolean  @default(false) @map("is_default")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([customerId])
  @@index([customerId, isDefault])
  @@map("customer_senders")
}

model CustomerReceiver {
  id         Int      @id @default(autoincrement())
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label      String?
  name       String
  phone      String?
  email      String?
  address1   String   @map("address_1") @db.Text
  address2   String?  @map("address_2") @db.Text
  city       String
  state      String
  zipCode    String   @map("zip_code")
  country    String   @default("US")
  isDefault  Boolean  @default(false) @map("is_default")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([customerId])
  @@index([customerId, isDefault])
  @@map("customer_receivers")
}

model CustomerPackage {
  id            Int          @id @default(autoincrement())
  customerId    String       @map("customer_id") @db.Uuid
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label         String?      // Tên gợi nhớ: "Hộp 1kg", "Túi nilon nhỏ"
  packageName   String       @map("package_name") // Tên hiển thị gói hàng
  packingTypeId Int?         @map("packing_type_id")
  packingType   PackingType? @relation(fields: [packingTypeId], references: [id], onDelete: SetNull)

  length        Float?
  width         Float?
  height        Float?
  weight        Float        // Cân nặng tính bằng Gram (gr)

  isDefault     Boolean      @default(false) @map("is_default")

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  @@index([customerId])
  @@index([customerId, isDefault])
  @@map("customer_packages")
}
