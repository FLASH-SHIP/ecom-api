model Province {
  id           Int        @id @default(autoincrement())
  name         String
  code         Int        @unique
  divisionType String     @map("division_type")
  codeName     String     @map("code_name")
  phoneCode    Int        @map("phone_code")
  wards        Ward[]

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@map("provinces")
}

model Ward {
  id           Int        @id @default(autoincrement())
  name         String
  code         Int        @unique
  divisionType String     @map("division_type")
  codeName     String     @map("code_name")
  provinceCode Int        @map("province_code")
  province     Province   @relation(fields: [provinceCode], references: [code], onDelete: Cascade)

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@index([provinceCode])
  @@index([codeName])
  @@map("wards")
}
model AdministrativeDivision {
  id           Int                 @id @default(autoincrement())
  countryCode  String              @map("country_code")
  code         String
  name         String
  nameEn       String?             @map("name_en")
  divisionType String              @map("division_type")
  level        Int
  parentId     Int?                @map("parent_id")
  parent       AdministrativeDivision? @relation("DivisionChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     AdministrativeDivision[] @relation("DivisionChildren")
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  deletedAt    DateTime?           @map("deleted_at")

  @@unique([countryCode, code])
  @@index([countryCode])
  @@map("administrative_divisions")
}
