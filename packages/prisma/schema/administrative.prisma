model Province {
  id           Int    @id @default(autoincrement())
  name         String
  code         Int    @unique
  divisionType String
  codeName     String
  phoneCode    Int
  wards        Ward[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("provinces")
}

model Ward {
  id           Int      @id @default(autoincrement())
  name         String
  code         Int      @unique
  divisionType String
  codeName     String
  provinceCode Int
  province     Province @relation(fields: [provinceCode], references: [code], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([provinceCode])
  @@index([codeName])
  @@map("wards")
}
model AdministrativeDivision {
  id           Int                 @id @default(autoincrement())
  countryCode  String
  code         String
  name         String
  nameEn       String?
  divisionType String
  level        Int
  parentId     Int?
  parent       AdministrativeDivision? @relation("DivisionChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     AdministrativeDivision[] @relation("DivisionChildren")
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  @@unique([countryCode, code])
  @@index([countryCode])
  @@map("administrative_divisions")
}
