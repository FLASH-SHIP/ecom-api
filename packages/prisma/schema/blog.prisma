// Ecom — Blog Module

model Post {
  id             Int               @id @default(autoincrement())
  title          String
  slug           String            @unique
  content        String?           @db.Text
  excerpt        String?           @db.Text
  featuredImage  String?
  bannerImage    String?
  isFeatured     Boolean           @default(false)
  allowComments  Boolean           @default(true)
  formatType     String?
  externalSource String?
  sponsoredBy    String?
  views          Int               @default(0)
  status         ContentStatus     @default(DRAFT)
  authorId       String            @db.Uuid
  author         User              @relation(fields: [authorId], references: [id])
  categories     PostCategory[]
  tags           PostTag[]
  translations   PostTranslation[]
  seoMeta        SeoMeta?          @relation("PostSeo")
  comments       Comment[]
  publishedAt    DateTime?
  scheduledAt    DateTime?
  expiresAt      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([slug])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([status, deletedAt, createdAt])
  @@index([status, deletedAt, publishedAt])
  @@index([scheduledAt])
  @@index([expiresAt])
  @@map("posts")
}

model PostTranslation {
  id       Int     @id @default(autoincrement())
  postId   Int
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  langCode String
  title    String
  slug     String?
  excerpt  String? @db.Text
  content  String? @db.Text

  @@unique([postId, langCode])
  @@map("post_translations")
}

model Category {
  id           Int                   @id @default(autoincrement())
  name         String
  slug         String                @unique
  description  String?               @db.Text
  icon         String?
  isFeatured   Int                   @default(0) @db.SmallInt
  isDefault    Int                   @default(0) @db.SmallInt
  status       ContentStatus         @default(PUBLISHED)
  parentId     Int?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  posts        PostCategory[]
  translations CategoryTranslation[]
  seoMeta      SeoMeta?              @relation("CategorySeo")
  authorId     String?
  order        Int                   @default(0)
  deletedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([parentId])
  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("categories")
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  langCode    String
  name        String
  description String?  @db.Text

  @@unique([categoryId, langCode])
  @@map("category_translations")
}

model Tag {
  id           Int              @id @default(autoincrement())
  name         String
  slug         String           @unique
  description  String?          @db.Text
  status       ContentStatus    @default(PUBLISHED)
  authorId     String?
  authorType   String           @default("User")
  posts        PostTag[]
  translations TagTranslation[]
  seoMeta      SeoMeta?         @relation("TagSeo")
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([deletedAt])
  @@map("tags")
}

model TagTranslation {
  id          Int     @id @default(autoincrement())
  tagId       Int
  tag         Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  langCode    String
  name        String
  description String? @db.Text

  @@unique([tagId, langCode])
  @@map("tag_translations")
}

model PostCategory {
  id         Int      @id @default(autoincrement())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int

  @@unique([postId, categoryId])
  @@map("post_categories")
}

model PostTag {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  Int

  @@unique([postId, tagId])
  @@map("post_tags")
}

model Comment {
  id          Int       @id @default(autoincrement())
  content     String    @db.Text
  authorName  String?
  authorEmail String?
  customerId  String?   @db.Uuid
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  postId      Int?
  post        Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  pageId      Int?
  page        Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentId    Int?
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")
  status      String    @default("pending") // pending, approved, spam, trash
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([postId])
  @@index([pageId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
  @@map("comments")
}
