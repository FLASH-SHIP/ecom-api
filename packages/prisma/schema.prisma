// Ecom — PostgreSQL Schema
// Phase 1: Auth + User + Authorization + Blog

generator client {
  provider = "prisma-client"
  output   = "./src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Auth & User
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  username      String?    @unique
  name          String?
  phone         String?
  avatarUrl     String?
  emailVerified DateTime?
  locale        String?    @default("vi")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Auth relations
  password     UserPassword?
  sessions     Session[]
  accounts     Account[]
  apiKeys      ApiKey[]
  accessTokens AccessToken[]

  // Authorization
  roles UserRoleAssignment[]

  // Business
  posts     Post[]
  pages     Page[]
  revisions Revision[]

  // Profile
  meta UserMeta[]

  // System
  auditLogs          AuditLog[]
  requestLogs        RequestLog[]
  contactAssignments ContactSubmission[] @relation("ContactAssignee")
  notifications      Notification[]      @relation("UserNotifications")

  @@index([status])
  @@map("users")
}

model UserPassword {
  hash   String
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_passwords")
}

// Key-value store for user preferences (theme, etc.) — mirrors Botble user_meta
model UserMeta {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   // e.g. "theme"
  value     String   // e.g. "dark" | "light"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
  @@map("user_meta")
}

// NextAuth.js sessions (Web — cookie-based)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
  @@map("sessions")
}

// NextAuth.js accounts (social login future-proof)
model Account {
  id                String  @id @default(cuid())
  userId            Int
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// NextAuth.js verification tokens (email verification)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// API Keys — long-lived, for scripts/CLI/integrations
model ApiKey {
  id         String    @id @default(cuid())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedKey  String    @unique
  label      String?
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([hashedKey])
  @@index([userId])
  @@map("api_keys")
}

// JWT Access/Refresh Tokens — for Mobile & Chrome Extension
model AccessToken {
  id               String    @id @default(cuid())
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  refreshTokenHash String    @unique
  clientType       String    @default("mobile") // mobile | extension
  deviceInfo       String?
  expiresAt        DateTime
  refreshExpiresAt DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([refreshTokenHash])
  @@map("access_tokens")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Authorization (RBAC)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Role {
  id          String               @id @default(cuid())
  name        String               @unique
  displayName String?
  description String?
  permissions RolePermission[]
  users       UserRoleAssignment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique // e.g. "blog.posts.create"
  displayName String?
  group       String?                  // e.g. "blog"
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Blog
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enum ContentStatus {
  DRAFT
  PENDING   // Submitted for review
  REVIEW    // Under review by editor
  REJECTED  // Rejected with feedback
  PUBLISHED
  ARCHIVED
}

model Post {
  id            Int            @id @default(autoincrement())
  title         String
  slug          String         @unique
  content       String?        @db.Text
  excerpt       String?        @db.Text
  featuredImage String?
  bannerImage   String?
  isFeatured    Boolean        @default(false)
  allowComments Boolean        @default(true)
  formatType    String?
  views         Int            @default(0)
  status        ContentStatus  @default(DRAFT)
  authorId      Int
  author        User           @relation(fields: [authorId], references: [id])
  categories    PostCategory[]
  tags          PostTag[]
  translations  PostTranslation[]
  seoMeta       SeoMeta?       @relation("PostSeo")
  comments      Comment[]
  publishedAt   DateTime?
  scheduledAt   DateTime?
  expiresAt     DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([slug])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([status, deletedAt, createdAt])
  @@index([status, deletedAt, publishedAt])
  @@index([scheduledAt])
  @@index([expiresAt])
  @@map("posts")
}

model PostTranslation {
  id          Int    @id @default(autoincrement())
  postId      Int
  post        Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  langCode    String
  title       String
  slug        String?
  excerpt     String? @db.Text
  content     String? @db.Text

  @@unique([postId, langCode])
  @@map("post_translations")
}

model Category {
  id           Int                   @id @default(autoincrement())
  name         String
  slug         String                @unique
  description  String?               @db.Text
  icon         String?
  isFeatured   Boolean               @default(false)
  isDefault    Boolean               @default(false)
  status       ContentStatus         @default(PUBLISHED)
  parentId     Int?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  posts        PostCategory[]
  translations CategoryTranslation[]
  seoMeta      SeoMeta?              @relation("CategorySeo")
  authorId     Int?
  order        Int                   @default(0)
  deletedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([parentId])
  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("categories")
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  langCode    String
  name        String
  description String?  @db.Text

  @@unique([categoryId, langCode])
  @@map("category_translations")
}

model Tag {
  id           Int              @id @default(autoincrement())
  name         String
  slug         String           @unique
  description  String?          @db.Text
  status       ContentStatus    @default(PUBLISHED)
  authorId     Int?
  authorType   String           @default("User")
  posts        PostTag[]
  translations TagTranslation[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("tags")
}

model TagTranslation {
  id          Int     @id @default(autoincrement())
  tagId       Int
  tag         Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  langCode    String
  name        String
  description String? @db.Text

  @@unique([tagId, langCode])
  @@map("tag_translations")
}

model PostCategory {
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int

  @@id([postId, categoryId])
  @@map("post_categories")
}

model PostTag {
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  Int

  @@id([postId, tagId])
  @@map("post_tags")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Pages (static content)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Page {
  id            Int           @id @default(autoincrement())
  title         String
  slug          String        @unique
  content       String?       @db.Text
  excerpt       String?       @db.Text
  featuredImage String?
  template      String?       @default("default")
  order         Int           @default(0)
  parentId      Int?
  parent        Page?         @relation("PageTree", fields: [parentId], references: [id])
  children      Page[]        @relation("PageTree")
  status        ContentStatus @default(DRAFT)
  authorId      Int
  author        User          @relation(fields: [authorId], references: [id])
  translations  PageTranslation[]
  seoMeta       SeoMeta?      @relation("PageSeo")
  comments      Comment[]
  publishedAt   DateTime?
  scheduledAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([slug])
  @@index([parentId])
  @@index([deletedAt])
  @@index([status, deletedAt, order])
  @@map("pages")
}

model PageTranslation {
  id       Int    @id @default(autoincrement())
  pageId   Int
  page     Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  langCode String
  title    String
  slug     String?
  content  String? @db.Text
  excerpt  String? @db.Text

  @@unique([pageId, langCode])
  @@map("page_translations")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Revisions (content history for posts/pages)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Revision {
  id            Int      @id @default(autoincrement())
  referenceId   Int
  referenceType String   // "post" | "page"
  title         String
  content       String?  @db.Text
  authorId      Int
  author        User     @relation(fields: [authorId], references: [id])
  note          String?
  createdAt     DateTime @default(now())

  @@index([referenceId, referenceType])
  @@index([authorId])
  @@map("revisions")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Media
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model MediaFolder {
  id        Int           @id @default(autoincrement())
  name      String
  slug      String        @unique
  parentId  Int?
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderTree")
  files     MediaFile[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([parentId])
  @@index([slug])
  @@map("media_folders")
}

model MediaFile {
  id          Int          @id @default(autoincrement())
  name        String
  fileName    String
  mimeType    String
  size        Int
  url         String
  disk        String       @default("local")
  width       Int?
  height      Int?
  alt         String?
  description String?      @db.Text
  folderId    Int?
  folder      MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy  Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([folderId])
  @@index([mimeType])
  @@index([uploadedBy])
  @@map("media_files")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// i18n & SEO
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Language {
  id        Int      @id @default(autoincrement())
  name      String
  locale    String   @unique
  code      String   @unique
  flag      String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  isRtl     Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meta      LanguageMeta[]

  @@map("languages")
}

model LanguageMeta {
  id            Int      @id @default(autoincrement())
  langCode      String
  origin        String
  referenceId   Int
  referenceType String
  language      Language @relation(fields: [langCode], references: [code], onDelete: Cascade)

  @@unique([referenceId, referenceType])
  @@index([langCode])
  @@index([origin])
  @@index([referenceId, referenceType])
  @@map("language_meta")
}

model SeoMeta {
  id            Int      @id @default(autoincrement())
  seoTitle      String?
  seoDescription String? @db.Text
  seoImage      String?
  indexMode     String?  @default("index")

  postId        Int?     @unique
  post          Post?    @relation("PostSeo", fields: [postId], references: [id], onDelete: Cascade)

  categoryId    Int?     @unique
  category      Category? @relation("CategorySeo", fields: [categoryId], references: [id], onDelete: Cascade)

  pageId        Int?     @unique
  page          Page?    @relation("PageSeo", fields: [pageId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("seo_meta")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Slug (centralized registry — cross-model uniqueness)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Slug {
  id            Int               @id @default(autoincrement())
  key           String
  referenceId   Int
  referenceType String
  prefix        String            @default("")
  translations  SlugTranslation[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([key, prefix])
  @@unique([referenceId, referenceType])
  @@map("slugs")
}

model SlugTranslation {
  id       Int    @id @default(autoincrement())
  slugId   Int
  slug     Slug   @relation(fields: [slugId], references: [id], onDelete: Cascade)
  langCode String
  key      String

  @@unique([slugId, langCode])
  @@map("slug_translations")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Custom Fields
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model FieldGroup {
  id        Int         @id @default(autoincrement())
  title     String
  order     Int         @default(0)
  rules     Json?       // Matching conditions: page_template, category, model_name, etc.
  status    String      @default("published") // "published" | "draft"
  items     FieldItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@map("field_groups")
}

model FieldItem {
  id           Int         @id @default(autoincrement())
  groupId      Int
  group        FieldGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parentId     Int?
  parent       FieldItem?  @relation("FieldItemTree", fields: [parentId], references: [id])
  children     FieldItem[] @relation("FieldItemTree")
  slug         String
  title        String
  type         String      // text, number, email, textarea, select, checkbox, radio, image, file, wysiwyg, repeater, color, date, url
  placeholder  String?
  instructions String?     @db.Text
  options      Json?       // For select/checkbox/radio: [{label, value}]
  defaultValue String?
  order        Int         @default(0)
  values       CustomFieldValue[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([groupId, slug])
  @@index([parentId])
  @@map("field_items")
}

model CustomFieldValue {
  id          Int       @id @default(autoincrement())
  fieldItemId Int
  fieldItem   FieldItem @relation(fields: [fieldItemId], references: [id], onDelete: Cascade)
  useFor      String    // "post" | "page" | "category"
  useForId    Int
  value       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([fieldItemId, useFor, useForId])
  @@index([useFor, useForId])
  @@map("custom_field_values")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Admin Menu (sidebar navigation)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model AdminMenuItem {
  id              Int                        @id @default(autoincrement())
  key             String                     @unique // e.g. "cms-core-dashboard"
  name            String                     // Default display name (English)
  description     String?                    @db.Text
  icon            String?                    // e.g. "ti ti-home"
  route           String?                    // Frontend route path, null = parent-only
  permissions     Json?                      // String[] of permission names for access control
  childrenDisplay String?                    @default("sidebar") // "sidebar" | "panel"
  section         String?                    // Section grouping for panel display
  priority        Int                        @default(0)
  isActive        Boolean                    @default(true)
  parentId        Int?
  parent          AdminMenuItem?             @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        AdminMenuItem[]            @relation("MenuTree")
  translations    AdminMenuItemTranslation[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([parentId])
  @@index([priority])
  @@index([isActive])
  @@map("admin_menu_items")
}

model AdminMenuItemTranslation {
  id          Int           @id @default(autoincrement())
  menuItemId  Int
  menuItem    AdminMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  langCode    String
  name        String
  description String?       @db.Text
  section     String?

  @@unique([menuItemId, langCode])
  @@map("admin_menu_item_translations")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Frontend Menus (Navigation management)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Menu {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  location  String?
  isActive  Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([location])
  @@index([isActive])
  @@map("menus")
}

model MenuItem {
  id            Int                   @id @default(autoincrement())
  menuId        Int
  menu          Menu                  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label         String
  url           String?
  target        String?               @default("_self")
  linkType      String                @default("custom")
  referenceId   Int?
  referenceType String?
  icon          String?
  cssClass      String?
  parentId      Int?
  parent        MenuItem?             @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      MenuItem[]            @relation("MenuItemTree")
  translations  MenuItemTranslation[]
  position      Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([menuId])
  @@index([parentId])
  @@index([position])
  @@map("menu_items")
}

model MenuItemTranslation {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  langCode   String
  label      String

  @@unique([menuItemId, langCode])
  @@map("menu_item_translations")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Settings (key-value store)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── Audit & System ─────────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  module     String   // posts, categories, users, roles, settings, etc.
  entityId   String?  // ID of the affected entity
  entityType String?  // Model name (Post, Category, User, etc.)
  oldValues  Json?    // Previous values (for UPDATE)
  newValues  Json?    // New values (for CREATE, UPDATE)
  ipAddress  String?
  userAgent  String?  @db.Text
  metadata   Json?    // Extra context
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RequestLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  method     String   // GET, POST, PUT, DELETE, etc.
  url        String   @db.Text
  statusCode Int?
  duration   Int?     // Response time in ms
  ipAddress  String?
  userAgent  String?  @db.Text
  referer    String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([method])
  @@index([statusCode])
  @@index([createdAt])
  @@map("request_logs")
}

// ─── Customers (Customer-facing) ────────────────────

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BANNED
}

model Customer {
  id                  Int            @id @default(autoincrement())
  email               String         @unique
  username            String         @unique
  usernameChangeCount Int            @default(0)
  usernameChangedAt   DateTime?
  name                String?
  phone               String?
  avatarUrl           String?
  hashedPassword      String?
  status              CustomerStatus @default(ACTIVE)
  emailVerified       DateTime?
  lastLoginAt         DateTime?
  dob                 DateTime?      @db.Date
  gender              String?
  description         String?        @db.Text
  metadata            Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  socialAccounts CustomerSocialAccount[]
  activityLogs   CustomerActivityLog[]
  comments       Comment[]

  @@index([status])
  @@index([email])
  @@index([username])
  @@map("customers")
}

model CustomerSocialAccount {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   String
  providerId String
  email      String?
  name       String?
  avatarUrl  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([customerId])
  @@map("customer_social_accounts")
}

model CustomerActivityLog {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  action     String
  ipAddress  String?
  userAgent  String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([action])
  @@index([createdAt])
  @@map("customer_activity_logs")
}

// ─── Webhook System ────────────────────────────────

model Webhook {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  secret    String?
  events    String[] // e.g. ["post.published", "customer.registered"]
  isActive  Boolean  @default(true)
  retries   Int      @default(3)
  timeout   Int      @default(30) // seconds
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs WebhookLog[]

  @@map("webhooks")
}

model WebhookLog {
  id         Int      @id @default(autoincrement())
  webhookId  Int
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  payload    Json?
  response   String?  @db.Text
  statusCode Int?
  success    Boolean  @default(false)
  attempts   Int      @default(1)
  error      String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([webhookId])
  @@index([event])
  @@index([createdAt])
  @@map("webhook_logs")
}

// ─── Comment System ────────────────────────────────

model Comment {
  id         Int       @id @default(autoincrement())
  content    String    @db.Text
  authorName String?
  authorEmail String?
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  postId     Int?
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  pageId     Int?
  page       Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentId   Int?
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")
  status     String    @default("pending") // pending, approved, spam, trash
  ipAddress  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([postId])
  @@index([pageId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
  @@map("comments")
}

// ─── Contact / Lead Management ─────────────────────

model ContactSubmission {
  id         Int      @id @default(autoincrement())
  formSlug   String   @default("default")
  name       String
  email      String
  phone      String?
  subject    String?
  message    String   @db.Text
  metadata   Json?    // extra fields from custom forms
  status     String   @default("new") // new, read, replied, archived
  assigneeId Int?
  assignee   User?    @relation("ContactAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  repliedAt  DateTime?
  ipAddress  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([formSlug])
  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

// ─── Notification System ───────────────────────────

model Notification {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type          String   // comment, contact, system, webhook
  title         String
  message       String   @db.Text
  link          String?  // URL to navigate to
  referenceId   Int?     // Related entity ID
  referenceType String?  // Related entity type
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// --- URL Redirect Management ---

model Redirect {
  id          Int      @id @default(autoincrement())
  fromPath    String   @unique
  toPath      String
  statusCode  Int      @default(301) // 301 = permanent, 302 = temporary
  isActive    Boolean  @default(true)
  hitCount    Int      @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fromPath])
  @@index([isActive])
  @@map("redirects")
}

// --- Generalized Taxonomy System ---

model Taxonomy {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String
  type        String     // e.g., "category", "tag", "topic", "series", "product_type"
  description String?
  parentId    Int?
  parent      Taxonomy?  @relation("TaxonomyTree", fields: [parentId], references: [id])
  children    Taxonomy[] @relation("TaxonomyTree")
  order       Int        @default(0)
  metadata    Json?      // Extensible key-value metadata
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([slug, type])
  @@index([type])
  @@index([parentId])
  @@map("taxonomies")
}

// --- Content Templates ---

model ContentTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  type        String   // "post", "page", "email"
  content     String?  @db.Text
  structure   Json?    // JSON layout/block structure
  thumbnail   String?
  isActive    Boolean  @default(true)
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@map("content_templates")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Form Builder
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Form {
  id              Int              @id @default(autoincrement())
  name            String
  slug            String           @unique
  description     String?          @db.Text
  successMessage  String?          @db.Text
  redirectUrl     String?
  isActive        Boolean          @default(true)
  notifyEmail     String?
  fields          FormField[]
  submissions     FormSubmission[]
  submissionCount Int              @default(0)
  createdBy       Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([isActive])
  @@map("forms")
}

model FormField {
  id           Int      @id @default(autoincrement())
  formId       Int
  form         Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  name         String
  label        String
  type         String   @default("text")
  placeholder  String?
  helpText     String?
  defaultValue String?
  options      Json?
  validations  Json?
  isRequired   Boolean  @default(false)
  position     Int      @default(0)
  width        String?  @default("full")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([formId])
  @@index([position])
  @@map("form_fields")
}

model FormSubmission {
  id        Int      @id @default(autoincrement())
  formId    Int
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      Json
  ipAddress String?
  userAgent String?  @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([formId])
  @@index([isRead])
  @@index([createdAt])
  @@map("form_submissions")
}
