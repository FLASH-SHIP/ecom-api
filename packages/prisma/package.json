{
  "name": "@ecom/prisma",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx seed.ts",
    "prisma:seed:core": "SEED_CATEGORY=core tsx seed.ts",
    "prisma:seed:business": "SEED_CATEGORY=business tsx seed.ts",
    "db:check-drift": "prisma migrate status",
    "db:reset": "prisma migrate reset --force && tsx seed.ts",
    "prisma:format:check": "prisma format --schema=schema",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist src/generated node_modules/.prisma"
  },
  "dependencies": {
    "@ecom/lib": "portal:../../../ecom-shared-packages/packages/lib",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@ecom/tsconfig": "portal:../../../ecom-shared-packages/packages/tsconfig",
    "@types/pg": "^8.15.0",
    "dotenv": "^16.5.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
