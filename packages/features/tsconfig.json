{
  "extends": "@flash-ship/ecom-tsconfig/library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "@ecom/features/*": ["./*"],
      "@flash-ship/ecom-trpc-types/*": ["../trpc/server/*"],
      "@flash-ship/ecom-trpc-types": ["../trpc/server/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"]
}
