meta {
  name: 4. Update Order
  type: http
  seq: 4
}

put {
  url: {{sbpBaseUrl}}/omm/v2/external/order_express/:orderNumber
  body: json
  auth: none
}

params:path {
  orderNumber: GB0000000001
}

headers {
  Authorization: Bearer {{sbpToken}}
  secret: {{sbpSecret}}
  lang: en
  Content-Type: application/json
}

body:json {
  {
    "orderNumberClient": "ABC00001_UPDATED",
    "stationCode": "HCM2",
    "serviceCode": "DOM_SHIP",
    "subServiceCodes": ["PUP_SCHEDULE", "DELIVERY_RC"],
    "senderData": {
      "customerLastName": "D Amore Updated",
      "customerPhone": "0345698123",
      "customerFullAddress": "85 Thang Long, P4, Tan Binh, HCM City, Vietnam",
      "countryCode": "VN",
      "provinceName": "Hồ Chí Minh",
      "districtName": "Tân Bình",
      "wardName": "04",
      "countryName": "Việt Nam"
    },
    "receiverData": {
      "customerLastName": "Nguyễn Văn A Updated",
      "customerPhone": "0123456789",
      "customerFullAddress": "85 Thang Long, P4, Tan Binh, HCM City, Vietnam",
      "countryCode": "VN",
      "provinceName": "Hồ Chí Minh",
      "districtName": "Tân Bình",
      "wardName": "04",
      "countryName": "Việt Nam"
    },
    "partnerCode": "SBP",
    "weightType": "kg",
    "dimType": "cm",
    "packageDetails": [
      {
        "description": "Package 1 updated",
        "weight": 3
      }
    ],
    "pcs": 1,
    "orderWeight": 3,
    "unitFee": "VND",
    "codAmount": 0
  }
}

docs {
  # 4. Update Order
  
  Cập nhật cấu hình hoặc thông tin địa chỉ/khối lượng của Order trước khi Check-in.
  
  Sử dụng path parameter `:orderNumber` đại diện cho mã đơn hàng cần cập nhật (ví dụ: `GB0000000001`).
}
