meta {
  name: Create Shipping Label
  type: http
  seq: 2
}

post {
  url: {{epicHubBaseUrl}}/v2/shipments/label-request
  body: json
  auth: none
}

headers {
  Token: {{epicHubToken}}
  Content-Type: application/json
}

